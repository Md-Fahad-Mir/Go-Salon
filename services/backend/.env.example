# Authentication configuration.
# Copy to .env and fill in. Nothing in here belongs in version control.

# --- Django ----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
# Deployment hosts. Nothing needs adding for local phone testing: with DEBUG
# on, this machine's current LAN address is worked out and allowed
# automatically, so a new DHCP lease cannot break the setup the way it used
# to. See "Testing on a phone" in the README.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- JWT -------------------------------------------------------------------
# Signing key for tokens. Defaults to DJANGO_SECRET_KEY when unset; set it
# separately if tokens and sessions should not share a secret.
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# --- One-time codes --------------------------------------------------------
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=15
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
PASSWORD_RESET_TOKEN_MAX_AGE_SECONDS=900

# --- Passwords -------------------------------------------------------------
PASSWORD_MIN_LENGTH=8

# --- SMS delivery ----------------------------------------------------------
# console  development only; codes go to the server log, refuses DEBUG=False
# locmem   tests
# http     a real gateway. Required for anything other than local development.
SMS_PROVIDER=console
SMS_BASE_URL=
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=
SMS_TIMEOUT_SECONDS=10

# --- Rate limits -----------------------------------------------------------
THROTTLE_ANON=60/min
THROTTLE_USER=240/min
THROTTLE_LOGIN=100/min
THROTTLE_REGISTER=100/hour
THROTTLE_OTP=100/hour
THROTTLE_PASSWORD_RESET=100/hour

# --- Frontend --------------------------------------------------------------
# Same again — nothing to add for local testing; DEBUG accepts private ranges.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- App -------------------------------------------------------------------
STARTING_TRY_ON_CREDITS=3

# --- Live booking updates --------------------------------------------------
# Where booking events are fanned out between server processes. Left blank the
# in-memory layer is used: real, but process-local, so one `runserver` is fine
# and two workers behind a load balancer would each only reach the dashboards
# connected to them. Set this (and install `channels-redis`) beyond that.
REDIS_URL=
