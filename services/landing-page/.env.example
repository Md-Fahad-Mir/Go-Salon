# Where the Go Salon PWA lives. Every "Try it free" / "Sign in" / "Register
# your salon" button links into it. Defaults to https://app.gosalon.com.
VITE_APP_URL=https://app.gosalon.com

# Optional. The Django API base (e.g. https://api.gosalon.com/api). When set,
# the Pricing section reads live plans from GET /subscription-tiers/ so edits
# made in the admin dashboard appear here; otherwise it shows the seeded
# Free / Basic / Advanced plans.
VITE_API_BASE_URL=
