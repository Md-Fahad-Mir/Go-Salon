# Copy to .env.local. Vite exposes only VITE_-prefixed variables to the client.

# The FastAPI hair-AI service (services/ai). The try-on flow calls this directly
# from the browser: POST /analyze reads the photo, POST /generate renders the
# chosen style onto it. Start the service with `python main.py` in services/ai.
# Its CORS_ORIGINS must list this app's origin.
VITE_AI_API_URL=http://localhost:8001

# The Django backend (services/backend). Authentication — sign-up, phone
# verification, sign-in, password reset — talks to this. Run it with
# `.venv/bin/python manage.py runserver` and keep its CORS_ALLOWED_ORIGINS
# listing this app's origin.
VITE_API_BASE_URL=http://localhost:8000/api

# The rest of the app (bookings, the catalogue, the provider screens) still
# answers from src/mockData.
VITE_APP_VERSION=0.1.0
