# ─── OpenRouter ──────────────────────────────────────────────────────────────
# One key serves both endpoints. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=mock-key-for-local-dev
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Vision model behind POST /analyze (face + hair analysis, recommendations).
# OpenRouter model IDs are namespaced provider/model.
OPENROUTER_MODEL=openai/gpt-4o
OPENROUTER_TIMEOUT=90

# Image model behind POST /generate (the hairstyle try-on render). It must be a
# model that accepts image input, since the customer's photo is sent as a
# reference image and edited. OpenRouter has no `input_fidelity` parameter, so
# how well the face survives the edit is down to the model itself:
#   google/gemini-3.1-flash-image  — default: cheap, fast, edits rather than re-generates
#   google/gemini-3-pro-image      — noticeably better, roughly 4x the price
#   openai/gpt-5-image             — OpenAI's image model on OpenRouter
OPENROUTER_IMAGE_MODEL=google/gemini-3.1-flash-image
OPENROUTER_IMAGE_QUALITY=high            # low | medium | high | auto
# quality=high costs and takes more than medium, and it is the single biggest
# lever on how real the result looks. Drop to medium to halve the wait.
OPENROUTER_IMAGE_OUTPUT_FORMAT=jpeg      # jpeg | png | webp
OPENROUTER_IMAGE_OUTPUT_COMPRESSION=90   # jpeg/webp only, 0-100
OPENROUTER_IMAGE_TIMEOUT=180
# Support for quality / output_format / aspect_ratio varies by model. Anything
# the model rejects is dropped and the request is retried without it.

# Optional attribution: shows this app on openrouter.ai rankings and in the
# account's activity feed. Neither is required to make a call.
OPENROUTER_APP_NAME=Hair AI Analysis API
# OPENROUTER_SITE_URL=https://your-app.example.com

# ─── HTTP ────────────────────────────────────────────────────────────────────
# Browsers call this service directly, so only these origins are allowed. Never
# use "*" here: every request carries a customer's photo.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174,http://localhost:4174,http://127.0.0.1:4174
# Optional: one regex for dynamic origins, e.g. testing from a phone on the LAN.
# CORS_ORIGIN_REGEX=^http://192\.168\.\d+\.\d+:5174$

MAX_UPLOAD_MB=10

# How much of the photo each endpoint keeps. Analysis gains nothing above 1024;
# the render holds the face better with more to work from.
ANALYSIS_INPUT_MAX_EDGE=1024
GENERATION_INPUT_MAX_EDGE=1536
HOST=0.0.0.0
PORT=8001

# ─── YouTube (optional) ──────────────────────────────────────────────────────
# Required for specific YouTube video links in tutorials. Without this the
# app falls back to a generic YouTube search-results link instead of a
# direct video. Get a key from https://console.cloud.google.com/apis/credentials
# after enabling "YouTube Data API v3".
YOUTUBE_API_KEY=mock-key-for-local-dev
YOUTUBE_MAX_RESULTS=3
YOUTUBE_SAFE_SEARCH=moderate
YOUTUBE_TIMEOUT=10
