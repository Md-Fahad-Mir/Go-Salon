# Copy to .env.local.

# The Django backend (services/backend).
#
# A relative path on purpose, mirroring services/frontend: in development
# Vite proxies /api to Django (see server.proxy in vite.config.ts), so the
# browser asks whatever origin it loaded the page from. A real deployment
# sets this to its own API origin at build time, e.g. https://api.gosalon.com/api.
VITE_API_BASE_URL=/api
